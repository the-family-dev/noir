{
  "name": "noir",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nodemon",
    "build": "node scripts/write-build-info.cjs && cross-env NODE_ENV=production next build && tsc --project tsconfig.server.json && tsc-alias -p tsconfig.server.json",
    "start": "cross-env NODE_ENV=production node dist/server/server.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop noir",
    "pm2:restart": "pm2 restart noir --update-env",
    "pm2:delete": "pm2 delete noir",
    "lint": "eslint"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.575.0",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "^4.15.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/cors": "^2.8.19",
    "@types/node": "^20.19.33",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.1",
    "eslint-config-next": "^0.2.4",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5"
  }
}
